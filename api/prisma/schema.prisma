enum HotelProductKind {
  CONSUMABLE
  LINEN
  CHEMICAL
  EQUIPMENT
}

enum HotelKitFrequency {
  EVERY_CLEANING
  CHECKOUT_ONLY
  EVERY_N_DAYS
