/// Housekeeping task for one room. A room has at most one open task.

// ---------------------------------------------------------------------------
// NOM / LFT art. 132 fr. XXXIV (registro electrónico de jornada, 2027)
// ---------------------------------------------------------------------------

/// Corrección de una checada SIN tocarla. La checada original es inmutable
/// (trigger append-only en la tabla); el ajuste guarda quién/cuándo/por qué y
/// el valor anterior/nuevo, y requiere aprobación de un segundo usuario.
enum PunchAdjustmentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PunchAdjustmentTarget {
  CLOCK
  REMOTE
  ACCESS
}

enum DistributionAgreementKind {
  INDIVIDUAL
  COLECTIVO
}

enum DistributionAgreementParty {
  WORKER
  UNION
}

/// Convenio de distribución de jornada (art. 58 LFT): evidencia de que el
/// horario/semana se acordó con la persona o su representación sindical.
model WorkdayDistributionAgreement {
  id           String @id @default(uuid())
  tenantId     String @default(dbgenerated("current_setting('app.tenant_id'::text, true)"))
  userId       String?
  user         User?  @relation("DistributionAgreementUser", fields: [userId], references: [id], onDelete: SetNull)
  scheduleId   String?
  kind         DistributionAgreementKind @default(INDIVIDUAL)
  party        DistributionAgreementParty @default(WORKER)
  scope        String @default("HORARIO")
  effectiveFrom DateTime @db.Date
  effectiveTo   DateTime? @db.Date
  evidenceText String
  acceptedHash String
  acceptedAt   DateTime?
  acceptedIp   String?
  acceptedById String?
  acceptedBy   User? @relation("DistributionAgreementAcceptor", fields: [acceptedById], references: [id], onDelete: SetNull)
  createdById  String?
  createdBy    User? @relation("DistributionAgreementCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([tenantId, userId])
  @@index([tenantId, scheduleId])
  @@map("workday_distribution_agreements")
}

model PunchAdjustment {
  id            String                @id @default(uuid())
  tenantId      String                @default(dbgenerated("current_setting('app.tenant_id'::text, true)"))
  /// Objetivo polimórfico: checada de reloj, marcaje remoto o evento de acceso.
  targetType    PunchAdjustmentTarget @default(CLOCK)
  targetId      String
  /// Compatibilidad: checada de reloj (null en marcajes remotos).
  punchId       String?
  punch         TimeClockPunch?       @relation(fields: [punchId], references: [id], onDelete: Restrict)
  remotePunchId String?
  remotePunch   RemotePunch?          @relation("RemotePunchAdjustments", fields: [remotePunchId], references: [id], onDelete: Restrict)
  requestedById String
  requestedBy   User                  @relation("PunchAdjustmentRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  /// Motivo obligatorio (por qué se corrige).
  reason        String
  /// Snapshot del valor vigente al momento de pedir el ajuste.
  previousState Json
  /// Valor propuesto (p. ej. `{ occurredAt: "..." }`).
  newState      Json
  status        PunchAdjustmentStatus @default(PENDING)
  decidedById   String?
  decidedBy     User?                 @relation("PunchAdjustmentDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt     DateTime?
  decisionNote  String?
  createdAt     DateTime              @default(now())

  @@index([tenantId])
  @@index([punchId])
  @@index([tenantId, targetType, targetId])
  @@index([status])
  @@index([requestedById])
  @@index([createdAt])
  @@map("punch_adjustments")
}

/// Configuración NOM por cliente. Si un campo es `null` se usa el default
/// global de `sys_config` (o el default legal calculado, p. ej. tope semanal
/// por año: 46 h 2027→2029, 40 h desde 2030).
/// Configuración fiscal y de prestaciones por cliente. Todo es editable: el
/// motor no hardcodea tablas de ISR/IMSS ni topes; si falta un dato, se reporta.
model PayrollSettings {
  tenantId                 String   @id
  tenant                   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  currency                 String   @default("MXN")
  defaultDailySalary       Decimal? @db.Decimal(12, 2)
  sbcDaily                 Decimal? @db.Decimal(12, 2)
  umaDaily                 Decimal? @db.Decimal(12, 2)
  overtimeHourlyDivisor    Int      @default(8)
  overtimeDoubleHoursPerWeek Int    @default(9)
  overtimeDoubleMultiplier Decimal  @default(2) @db.Decimal(4, 2)
  overtimeTripleMultiplier Decimal  @default(3) @db.Decimal(4, 2)
  aguinaldoDays            Int      @default(15)
  aguinaldoExemptUmas      Decimal  @default(30) @db.Decimal(6, 2)
  vacationPremiumPct       Decimal  @default(25) @db.Decimal(5, 2)
  primaVacacionalExemptUmas Decimal @default(15) @db.Decimal(6, 2)
  valesMonthly             Decimal? @db.Decimal(12, 2)
  valesExemptMonthly       Decimal? @db.Decimal(12, 2)
  fondoAhorroPct           Decimal? @db.Decimal(5, 2)
  fondoAhorroCapMonthly    Decimal? @db.Decimal(12, 2)
  fondoAhorroExemptMonthly Decimal? @db.Decimal(12, 2)
  ptuRatePct               Decimal  @default(10) @db.Decimal(5, 2)
  isrEnabled               Boolean  @default(false)
  isrBrackets              Json?
  isrSubsidyMonthly        Decimal? @db.Decimal(12, 2)
  imssEnabled              Boolean  @default(false)
  imssRates                Json?
  primaAntiguedadDaysPerYear Int    @default(12)
  primaAntiguedadCapDaily  Decimal? @db.Decimal(12, 2)
  severanceMonths          Decimal  @default(3) @db.Decimal(4, 2)
  severanceDaysPerYear     Int      @default(20)
  updatedById              String?
  updatedBy                User?    @relation("PayrollSettingsUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
  updatedAt                DateTime @updatedAt

  @@map("payroll_settings")
}

model NomSettings {
  tenantId             String    @id
  tenant               Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// Tope de jornada diaria (ordinaria + extra). Máximo legal: 12 h = 720.
  workdayLimitMinutes  Int?
  /// Tope semanal. `null` = calcular por año (48/46/44/42/40 h de 2026 a 2030+); solo más estricto que la ley.
  weeklyLimitMinutes   Int?
  /// Meses que un registro queda activo antes de archivarse. `null`/0 = sin archivado.
  retentionMonths      Int?
  /// Defaults de asistencia para horarios nuevos (retardos/comida/extra).
  defaultEntryToleranceMin Int?
  defaultExitToleranceMin  Int?
  defaultMealBreakMin      Int?
  defaultMinOvertimeMin    Int?
  /// ¿Se permite el marcaje remoto (app/web) para este cliente? (F2-07)
  remotePunchEnabled   Boolean   @default(true)
  /// ¿Las checadas web/app cuentan para la jornada cuando no hay reloj? (RJ-02)
  remoteCountsForWorkday Boolean @default(true)
  /// D-4: bloquear checada web si el trabajador no aceptó un acuerdo con REMOTE.
  blockRemoteWithoutAgreement Boolean @default(true)
  /// D-1: en convenio colectivo exigir representación sindical (parte UNION).
  requireUnionForCollective Boolean @default(true)
  /// Política de teletrabajo editable por cliente (NOM-037 / F2-08).
  teleworkPolicy       String?
  /// Política de desconexión digital (NOM-037 / F2-08).
  disconnectPolicy     String?
  /// Aviso de privacidad editable por cliente (validación legal fuera del sistema).
  privacyNotice        String?
  /// Versiones que el trabajador acepta (consentimiento).
  policyVersion        Int       @default(1)
  privacyNoticeVersion Int       @default(1)
  policiesUpdatedAt    DateTime?
  updatedById          String?
  updatedBy            User?     @relation("NomSettingsUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
  updatedAt            DateTime  @updatedAt

  @@map("nom_settings")
}

enum WorkdayAlertScope {
  DAY
  WEEK
}

/// Alerta emitida al detectar una jornada/semana por encima del límite legal
/// configurado. Se persiste para que la campanita/historial de RH no dependa
/// del barrido y para no repetir el aviso (única por persona/escala/día).
model WorkdayLimitAlert {
  id            String            @id @default(uuid())
  tenantId      String            @default(dbgenerated("current_setting('app.tenant_id'::text, true)"))
  userId        String
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  scope         WorkdayAlertScope
  /// Día local (`DATE`) que ancla la alerta; en WEEK es el primer día de la semana.
  date          DateTime          @db.Date
  workedMinutes Int
  limitMinutes  Int
  notifyCount   Int               @default(0)
  notifiedAt    DateTime          @default(now())
  createdAt     DateTime          @default(now())

  @@unique([tenantId, userId, scope, date])
  @@index([tenantId, createdAt])
  @@map("workday_limit_alerts")
}

// ---------------------------------------------------------------------------
// F1B-13/17 — Agente local del cliente (TimeManagerAgent)
// ---------------------------------------------------------------------------

/// Agente local del cliente: el "brazo" que corre en la red del cliente, habla
/// ISAPI con sus relojes y sube checadas al API. La credencial es un token de
/// dispositivo por cliente: en BD solo vive su hash SHA-256, es revocable
/// (`active = false`) y rotable (`POST /agent/token`).
model Agent {
  id         String     @id @default(uuid())
  tenantId   String
  /// Nombre para reconocerlo en soporte (p. ej. "PC recepción").
  name       String
  /// SHA-256 hex del token de dispositivo; el token en claro solo se muestra al crearlo/rotarlo.
  tokenHash  String     @unique
  /// Versión instalada de TimeManagerAgent, reportada por el propio agente.
  version    String?
  active     Boolean    @default(true)
  lastSeenAt DateTime?
  lastSyncAt DateTime?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  jobs       AgentJob[]

  @@index([tenantId])
  @@map("agents")
}

/// Trabajo pedido desde la nube para que un agente lo ejecute contra el reloj.
/// La cola vive en esta tabla hasta que entre pg-boss (A1): `AgentJobQueue` en
/// `modules/agent/services/agent-job-queue.ts` es la interfaz que se sustituye.
model AgentJob {
  id          String         @id @default(uuid())
  tenantId    String
  /// Agente al que se le asignó; `null` = cualquiera del cliente puede tomarlo.
  agentId     String?
  agent       Agent?         @relation(fields: [agentId], references: [id], onDelete: SetNull)
  /// Reloj objetivo (serie); `null` = el trabajo no es de un reloj concreto.
  clockSerial String?
  type        AgentJobType
  payload     Json           @default("{}")
  status      AgentJobStatus @default(PENDING)
  attempts    Int            @default(0)
  maxAttempts Int            @default(5)
  /// Antes de esta hora no se reclama (backoff de reintentos).
  availableAt DateTime       @default(now())
  claimedAt   DateTime?
  finishedAt  DateTime?
  result      Json?
  error       String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([tenantId, status, availableAt])
  @@index([agentId])
  @@map("agent_jobs")
}

/// Trabajos que el agente ejecuta contra el reloj (los define el API; el
/// agente los consume en `GET /agent/jobs`).
enum AgentJobType {
  /// Leer checadas del reloj y subirlas (consola o botón "Sincronizar ahora").
  SYNC
  PERSON_ADD
  PERSON_REMOVE
  CARD_ADD
  CARD_REMOVE
  FINGERPRINT_APPLY
}

enum AgentJobStatus {
  PENDING
  RUNNING
  DONE
  FAILED
  CANCELLED
}

// ---------------------------------------------------------------------------
// F2-07 — Marcaje remoto (home office / campo), sin reloj físico
// ---------------------------------------------------------------------------

enum RemotePunchType {
  ENTRY
  EXIT
  LUNCH_START
  LUNCH_END
}

/// Modalidad declarada al marcar (NOM-037 distingue teletrabajo del trabajo
/// presencial/campo).
enum RemoteWorkMode {
  PRESENCIAL
  HIBRIDO
  REMOTO
  CAMPO
}

/// Marcaje remoto: inicio/fin de jornada capturado por el propio trabajador
/// (web/app), sin reloj. `occurredAt` es la hora del SERVIDOR (autoritativa);
/// la geolocalización es OPCIONAL y se guarda solo en este registro, en el
/// momento del marcaje (no hay rastreo continuo). Append-only por trigger.
model RemotePunch {
  id                String          @id @default(uuid())
  tenantId          String          @default(dbgenerated("current_setting('app.tenant_id'::text, true)"))
  userId            String
  user              User            @relation("RemotePunchUser", fields: [userId], references: [id], onDelete: Restrict)
  type              RemotePunchType
  workMode          RemoteWorkMode  @default(REMOTO)
  /// Hora autoritativa (servidor). El reloj del dispositivo no manda.
  occurredAt        DateTime        @default(now())
  /// Hora reportada por el cliente, solo auditoría (reintentos offline).
  clientReportedAt  DateTime?
  latitude          Float?
  longitude         Float?
  gpsAccuracyMeters Float?
  note              String?
  /// Idempotencia del cliente: un reintento de red no duplica el marcaje.
  clientEventId     String?         @unique
  adjustments       PunchAdjustment[] @relation("RemotePunchAdjustments")
  createdAt         DateTime        @default(now())

  @@index([tenantId])
  @@index([userId, occurredAt])
  @@index([tenantId, occurredAt])
  @@map("remote_punches")
}

// ---------------------------------------------------------------------------
// F2-08 — NOM-037 teletrabajo
// ---------------------------------------------------------------------------

enum TeleworkMode {
  REMOTO
  HIBRIDO
  CAMPO
}

enum TeleworkStatus {
  ACTIVE
  ENDED
}

/// Registro de una persona como teletrabajadora del cliente. Uno por persona
/// (`@@unique([tenantId, userId])`); se puede terminar y reactivar. Guarda el
/// consentimiento del trabajador sobre la política y el aviso de privacidad
/// vigentes (versiones) y el domicilio de teletrabajo (opcional, dato sensible).
model TeleworkRegistration {
  id                    String         @id @default(uuid())
  tenantId              String         @default(dbgenerated("current_setting('app.tenant_id'::text, true)"))
  userId                String
  user                  User           @relation("TeleworkRegistrationUser", fields: [userId], references: [id], onDelete: Cascade)
  mode                  TeleworkMode   @default(REMOTO)
  status                TeleworkStatus @default(ACTIVE)
  /// Domicilio donde se ejecuta el teletrabajo (opcional; dato sensible).
  homeAddress           String?
  /// % de la relación laboral en teletrabajo (NOM-037 5.1; alerta si <40 %).
  teleworkPercent       Int?
  activities            String?
  position              String?
  /// Lugares convenidos de trabajo (JSON array).
  workPlaces            Json?
  startedAt             DateTime       @default(now())
  endedAt               DateTime?
  /// Consentimiento de política/aviso (NOM-037 / LFPDPPP); versión aceptada.
  consentAcceptedAt     DateTime?
  consentPolicyVersion  Int?
  consentPrivacyVersion Int?
  notes                 String?
  createdById           String?
  createdBy             User?          @relation("TeleworkRegistrationCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  checklists TeleworkChecklist[]

  @@unique([tenantId, userId])
  @@index([tenantId, status])
  @@index([userId])
  @@map("telework_registrations")
}

enum TeleworkChecklistKind {
  INITIAL
  PERIODIC
}

enum TeleworkChecklistResult {
  APTO
  NO_APTO
}

/// Checklist del lugar de teletrabajo (NOM-037): inicial al alta y periódico.
/// Las respuestas se guardan como JSON validado contra la plantilla del API.
model TeleworkChecklist {
  id             String                @id @default(uuid())
  tenantId       String                @default(dbgenerated("current_setting('app.tenant_id'::text, true)"))
  registrationId String
  registration   TeleworkRegistration  @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  userId         String
  user           User                  @relation("TeleworkChecklistUser", fields: [userId], references: [id], onDelete: Cascade)
  kind           TeleworkChecklistKind
  /// `{ "space_adequate": "YES"|"NO", ... }` (todas las claves de la plantilla).
  answers        Json
  completedAt    DateTime              @default(now())
  createdById    String?
  /// Validación por la Comisión de Seguridad e Higiene (NOM-037 5.4/5.5).
  validatedById  String?
  validatedAt    DateTime?
  result         TeleworkChecklistResult?
  validationNotes String?

  @@index([tenantId, userId])
  @@index([registrationId])
  @@index([tenantId, completedAt])
  @@map("telework_checklists")
}

/// Equipo de cómputo/ergonómico entregado al teletrabajador (NOM-037 5.7),
/// con acuse de recibo del trabajador.
model TeleworkEquipmentDelivery {
  id         String @id @default(uuid())
