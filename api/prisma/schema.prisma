  @@index([tenantId, contactedAt])
  @@index([userId, contactedAt])
  @@map("out_of_hours_contacts")
}

// ---------------------------------------------------------------------------
// F1B-12 — Estación de huellas configurable (central o en sitio)
// ---------------------------------------------------------------------------

/// Configuración de la estación de enrolamiento de huellas (DS-K1F600U).
/// Una fila por alcance: `tenantId = null` es el default de plataforma y una
/// fila con `tenantId` es el override de ese cliente (estación en sitio).
/// La contraseña se guarda cifrada (AES-256-GCM) y nunca se devuelve.
model FingerprintStationConfig {
  id                String   @id @default(uuid())
  /// `null` = configuración de plataforma; con valor = override del cliente.
  tenantId          String?  @unique
  url               String
  username          String
  passwordEncrypted String
  updatedById       String?
  updatedAt         DateTime @updatedAt

  @@map("fingerprint_station_configs")
}
