generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum DiscountType {
  INFONAVIT
  IMSS
  CHILD_SUPPORT
}

enum DisciplinaryReason {
  ABSENCE
  TARDINESS
  INTOXICATION
  MISCONDUCT
  NONCOMPLIANCE
  OTHER
}

// Control de acceso (entradas/salidas de personal con credencial).
enum AccessEventType {
  ENTRY
  EXIT
}

// Cómo se obtuvo el "dónde" del escaneo: GPS del dispositivo, solo el sitio
// del catálogo, o captura manual (reservado, no usado en MVP).
enum AccessLocationSource {
  GPS
  SITE_ONLY
  MANUAL
}

// Medio por el que se registró el evento.
enum AccessMethod {
  QR_SCAN
  MANUAL
}

// ---------------------------------------------------------------------------
// Multi-tenancy: cada fila de las tablas de cliente lleva `tenantId`. El
// default de BD lo toma del contexto (`current_setting('app.tenant_id')`); si
// nadie lo puso, la inserción falla ruidosamente. En `User`/`AuditLog`/
// `EmailLog` es nullable: `null` = registro de plataforma (sin cliente).
// ---------------------------------------------------------------------------

enum TenantStatus {
  ACTIVE
  SUSPENDED
}

/// Cliente de la plataforma. Todo el personal y los datos de negocio cuelgan
/// de uno; los usuarios de plataforma (`ADMIN`/`SUPPORT`) no pertenecen a ninguno.
model Tenant {
  id            String       @id @default(uuid())
  name          String
  slug          String       @unique
  status        TenantStatus @default(ACTIVE)
  timezone      String       @default("America/Mexico_City")
  /// Primer día de la semana laboral (0=domingo … 6=sábado; 3=miércoles).
  weekStartDay  Int          @default(3)
  /// Plan contratado. `null` = sin plan (no aplica límites).
  planId        String?
  plan          Plan?        @relation(fields: [planId], references: [id], onDelete: SetNull)
  /// Override explícito del límite de personal del plan (soporte excepcional).
  employeeLimit Int?

  // Branding por cliente (F3-05): color de acento, logo (data URL) y remitente
  // de correo propio. `null` = se usa la marca TimeManager / Resend del .env.
  brandColor  String?
  logoDataUrl String?
  emailFrom   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users User[]

  // Configuración NOM por cliente (límites de jornada y retención).
  nomSettings NomSettings?
  payrollSettings PayrollSettings?
  payments TenantPayment[]

  @@index([planId])
  @@map("tenants")
}

/// Catálogo de planes del SaaS (F3-09): qué incluye cada uno (personal y
/// relojes) y su precio de lista mensual. El cobro es manual/pospuesto: aquí
/// solo viven los datos que la consola de plataforma administra.
enum TenantPaymentStatus {
  PENDING
  PAID
  OVERDUE
  CANCELLED
}

/// Kardex de cobros del cliente (plataforma). No es facturación fiscal: registra
/// los cargos estimados/manuales y su pago para dar seguimiento.
model TenantPayment {
  id        String @id @default(uuid())
  tenantId  String
  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  concept   String
  /// Periodo cobrado `YYYY-MM`.
  period    String
  amount    Decimal @db.Decimal(12, 2)
  dueDate   DateTime @db.Date
  status    TenantPaymentStatus @default(PENDING)
  paidAt    DateTime?
  method    String?
  reference String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, period, concept])
  @@index([tenantId, dueDate])
  @@map("tenant_payments")
}

model Plan {
  id            String   @id @default(uuid())
  /// Clave estable para el código y el backfill del `plan` viejo (p. ej. `PLAN_500`).
  key           String   @unique
  name          String
  /// Personas activas incluidas.
  employeeLimit Int
  /// Relojes checadores incluidos.
  clockLimit    Int
  /// Precio mensual de lista; `null` = por definir.
  monthlyPrice  Decimal? @db.Decimal(12, 2)
  active        Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenants Tenant[]

  @@map("plans")
}

model Department {
  id        String   @id @default(uuid())
  tenantId  String   @default(dbgenerated("current_setting('app.tenant_id'::text, true)"))
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subareas Subarea[]
  users    User[]

  payrollReviews PayrollDepartmentReview[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("departments")
}

model Subarea {
  id           String     @id @default(uuid())
  tenantId     String     @default(dbgenerated("current_setting('app.tenant_id'::text, true)"))
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  name         String
  active       Boolean    @default(true)
  createdAt    DateTime   @default(now())

  users User[]

  @@unique([departmentId, name])
  @@index([tenantId])
  @@map("subareas")
}

model User {
  id                 String           @id @default(uuid())
  /// Cliente al que pertenece; `null` = usuario de plataforma (ADMIN/SUPPORT).
  /// La unicidad de username/email/employeeNumber es por cliente; la de los de
  /// plataforma la da un índice único parcial creado en la migración.
  tenantId           String?
  tenant             Tenant?          @relation(fields: [tenantId], references: [id])
  username           String
  email              String?
  password           String
  /// Contraseña provisional: se obliga a cambiarla al entrar.
  mustChangePassword Boolean          @default(false)
  name               String
  role               String           @default("EMPLOYEE")
  roleRef            Role             @relation(fields: [role], references: [key])
  extraRoles         UserRole[]
  permissionGrants   UserPermission[] @relation("UserPermissionGrants")
  permissionsGranted UserPermission[] @relation("UserPermissionGrantedBy")
  policiesCreated    Policy[]         @relation("PolicyCreatedBy")
  weeklyOvertimeLedgers WeeklyOvertimeLedger[] @relation("WeeklyOvertimeLedgerUser")
  recordAgreement       WorkRecordAgreement? @relation("WorkRecordAgreementUser")
  recordAgreementsSigned WorkRecordAgreement[] @relation("WorkRecordAgreementEmployer")
  payrollSettingsUpdated PayrollSettings[] @relation("PayrollSettingsUpdater")
  recordAcknowledgments WorkRecordAcknowledgment[] @relation("WorkRecordAcknowledgmentUser")
  overtimeRequests      OvertimeRequest[] @relation("OvertimeRequestUser")
  overtimeRequestsMade  OvertimeRequest[] @relation("OvertimeRequestRequester")
  active             Boolean          @default(true)
  jobTitle           String?
  employeeNumber     String?

  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])
  subareaId    String?
  subarea      Subarea?    @relation(fields: [subareaId], references: [id])

  // Personal / Recursos Humanos (expediente extendido, opcional)
  middleName      String?
  paternalSurname String?
  maternalSurname String?
  photoKey        String?

  genderId          String?
  gender            Gender?    @relation(fields: [genderId], references: [id], onDelete: SetNull)
  bloodTypeId       String?
  bloodType         BloodType? @relation(fields: [bloodTypeId], references: [id], onDelete: SetNull)
  medicalConditions String?
  allergies         String?

  birthDate DateTime? @db.Date
  hireDate  DateTime? @db.Date

  rfc  String?
  curp String?
  nss  String?

  streetAddress String?
  neighborhood  String?
  postalCode    String?
  city          String?
  addressState  String?
  country       String? @default("México")

  personalPhone String?
  workPhone     String?

  emergencyContactName         String?
  emergencyContactPhone        String?
  emergencyContactRelationship String?

  discounts         EmployeeDiscount[]
  documents         EmployeeDocument[] @relation("EmployeeDocuments")
  uploadedDocuments EmployeeDocument[] @relation("EmployeeDocumentsUploader")

  disciplinaryReports         DisciplinaryReport[] @relation("DisciplinaryReportEmployee")
  authoredDisciplinaryReports DisciplinaryReport[] @relation("DisciplinaryReportAuthor")

  // Baja lógica explícita (separada de `active`, que cubre soft-delete físico).
  deactivatedAt          DateTime?
  deactivatedById        String?
  deactivatedBy          User?            @relation("UserDeactivator", fields: [deactivatedById], references: [id], onDelete: SetNull)
  deactivationReason     String?
  /// Motivo estructurado de la baja (catálogo `removal_categories`); obligatorio en las bajas del reloj.
  deactivationCategoryId String?
  deactivationCategory   RemovalCategory? @relation("UserDeactivationCategory", fields: [deactivationCategoryId], references: [id], onDelete: SetNull)
  deactivatedByUsers     User[]           @relation("UserDeactivator")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  notifications Notification[]

  sysConfigUpdates SysConfig[] @relation("SysConfigUpdater")

  // Control de acceso: el empleado es el sujeto del evento; el guardia, quien
  // lo registra. Relaciones con nombre para distinguir ambos roles.
  accessEventsAsEmployee AccessEvent[] @relation("AccessEventEmployee")
  accessEventsAsGuard    AccessEvent[] @relation("AccessEventGuard")

  scheduleAssignments        ScheduleAssignment[] @relation("ScheduleAssignee")
  createdScheduleAssignments ScheduleAssignment[] @relation("ScheduleAssignmentCreator")

  // Reloj checador: números del reloj vinculados a la persona y los vínculos
  // que capturó (relaciones con nombre para distinguir ambos roles).
  timeClockEmployees    TimeClockEmployee[] @relation("TimeClockEmployeeUser")
  createdTimeClockLinks TimeClockEmployee[] @relation("TimeClockEmployeeLinker")

  // Tiempo extra: decisiones de aprobación por persona y día, y las que capturó.
  overtimeApprovals OvertimeApproval[] @relation("OvertimeApprovalUser")
  overtimeDecisions OvertimeApproval[] @relation("OvertimeApprovalDecider")

  // Pre-nómina: cierres de semana y revisiones de departamento capturadas.
  payrollWeeksClosed   PayrollWeekClosure[]      @relation("PayrollWeekCloser")
  payrollWeeksReopened PayrollWeekClosure[]      @relation("PayrollWeekReopener")
  payrollReviews       PayrollDepartmentReview[] @relation("PayrollDepartmentReviewer")

  // NOM: correcciones de checadas (F2-01) y alertas de límite de jornada (F2-03).
  punchAdjustmentsRequested PunchAdjustment[]   @relation("PunchAdjustmentRequester")
  punchAdjustmentsDecided   PunchAdjustment[]   @relation("PunchAdjustmentDecider")
  nomSettingsUpdated        NomSettings[]       @relation("NomSettingsUpdater")
  workdayLimitAlerts        WorkdayLimitAlert[]

  // Marcaje remoto y NOM-037 teletrabajo (F2-07/F2-08).
  remotePunches                RemotePunch[]          @relation("RemotePunchUser")
  teleworkRegistrations        TeleworkRegistration[] @relation("TeleworkRegistrationUser")
  createdTeleworkRegistrations TeleworkRegistration[] @relation("TeleworkRegistrationCreator")
  teleworkChecklists           TeleworkChecklist[]    @relation("TeleworkChecklistUser")
  teleworkEquipmentDeliveries  TeleworkEquipmentDelivery[] @relation("TeleworkEquipmentUser")
  teleworkTrainings            TeleworkTraining[] @relation("TeleworkTrainingUser")
  teleworkNotices              TeleworkNotice[] @relation("TeleworkNoticeUser")
  teleworkReversalRequests     TeleworkReversalRequest[] @relation("TeleworkReversalUser")
  teleworkMedicalExams         TeleworkMedicalExam[] @relation("TeleworkMedicalExamUser")
  leaveRequests                LeaveRequest[] @relation("LeaveRequestUser")
  distributionAgreements       WorkdayDistributionAgreement[] @relation("DistributionAgreementUser")
  distributionAccepted         WorkdayDistributionAgreement[] @relation("DistributionAgreementAcceptor")
  distributionCreated          WorkdayDistributionAgreement[] @relation("DistributionAgreementCreator")
  outOfHoursContacts           OutOfHoursContact[]    @relation("OutOfHoursContactUser")
  createdOutOfHoursContacts    OutOfHoursContact[]    @relation("OutOfHoursContactCreator")

  @@unique([tenantId, username])
  @@unique([tenantId, email])
  @@unique([tenantId, employeeNumber])
  @@index([deactivatedAt])
  @@index([tenantId])
  @@map("users")
}

model Gender {
  id        String   @id @default(uuid())
  name      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  users User[]

  @@map("genders")
}

model BloodType {
  id        String   @id @default(uuid())
  name      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  users User[]

  @@map("blood_types")
}

model DocumentType {
  id        String   @id @default(uuid())
  tenantId  String   @default(dbgenerated("current_setting('app.tenant_id'::text, true)"))
  name      String
  active    Boolean  @default(true)
  /// Obligatorio en el expediente (el alta lo exige; el tablero de RH marca a quien le falta).
  required  Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  documents EmployeeDocument[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("document_types")
}

model EmployeeDiscount {
  id        String       @id @default(uuid())
  tenantId  String       @default(dbgenerated("current_setting('app.tenant_id'::text, true)"))
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      DiscountType
  note      String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@unique([userId, type])
  @@index([tenantId])
  @@map("employee_discounts")
}

model EmployeeDocument {
  id             String       @id @default(uuid())
  tenantId       String       @default(dbgenerated("current_setting('app.tenant_id'::text, true)"))
  userId         String
  user           User         @relation("EmployeeDocuments", fields: [userId], references: [id], onDelete: Cascade)
  documentTypeId String
  documentType   DocumentType @relation(fields: [documentTypeId], references: [id])
  storageKey     String       @unique
  originalName   String
  mimeType       String
  sizeBytes      Int
  uploadedById   String
  uploadedBy     User         @relation("EmployeeDocumentsUploader", fields: [uploadedById], references: [id])
  createdAt      DateTime     @default(now())

  @@index([tenantId])
  @@index([userId])
  @@index([documentTypeId])
  @@map("employee_documents")
}

model Notification {
  id        String   @id @default(uuid())
  tenantId  String   @default(dbgenerated("current_setting('app.tenant_id'::text, true)"))
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  detail    String?
  read      Boolean  @default(false)
  /// NOM-037 4.11/7.3 e): si el destinatario es teletrabajador y está fuera de
  /// su jornada, la notificación se difiere hasta su siguiente jornada.
  deferredUntil DateTime?
  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([userId, read])
  @@index([userId, createdAt(sort: Desc)])
  @@map("notifications")
}

model AuditLog {
  id            String   @id @default(uuid())
  /// `null` = acción de plataforma (operadores TimeManager, sin cliente).
  tenantId      String?
  action        String
  entityType    String
  entityId      String
  userId        String?
  userName      String?
  previousState Json?
  newState      Json?
  metadata      Json?
  createdAt     DateTime @default(now())

  @@index([tenantId])
  @@index([action])
  @@index([entityType, entityId])
  @@index([userId])
  @@index([createdAt])
  @@map("audit_logs")
}

model DisciplinaryReport {
  id           String             @id @default(uuid())
  tenantId     String             @default(dbgenerated("current_setting('app.tenant_id'::text, true)"))
  reason       DisciplinaryReason
  incidentDate DateTime           @db.Date
  description  String
  sanction     String?
  createdAt    DateTime           @default(now())

  userId      String
  user        User   @relation("DisciplinaryReportEmployee", fields: [userId], references: [id], onDelete: Cascade)
  createdById String
  createdBy   User   @relation("DisciplinaryReportAuthor", fields: [createdById], references: [id])

  @@index([tenantId])
  @@index([userId])
  @@index([createdAt(sort: Desc)])
  @@map("disciplinary_reports")
}

// Configuración del sistema editable desde el panel de catálogos.
// Permite mover valores que antes vivían en `process.env` a una tabla
// gestionable por el ADMIN en tiempo de ejecución, con auditoría.
model SysConfig {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt
  updatedById String?
  updatedBy   User?    @relation("SysConfigUpdater", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([updatedAt(sort: Desc)])
  @@map("sys_config")
}

// Estado de un registro de correo en la cola/bitácora de envíos.
enum EmailLogStatus {
  PENDING
  SENT
  FAILED
  CANCELLED
}

// Cola de correo + bitácora de envíos (outbox pattern). Cada trigger de
// notificación solo INSERTA una fila PENDING (sin SMTP en el request); un
// worker en background la drena con `sendEmail` y la marca SENT/FAILED.
// Las filas terminales no se borran: es el log de envíos consultable por
// el ADMIN. `attachments` guarda referencias S3 `[{storageKey, originalName,
// contentType}]`; el worker descarga el objeto al enviar.
model EmailLog {
  id            String         @id @default(cuid())
  /// `null` = correo de plataforma (bienvenida de cliente, alertas operativas).
  tenantId      String?
  to            String
  subject       String
  html          String
  attachments   Json? // [{storageKey, originalName, contentType}]
  action        String? // "user.deactivate", "ticket.comment", "document.uploaded", ...
  entityType    String?
  entityId      String?
  status        EmailLogStatus @default(PENDING)
  attempts      Int            @default(0)
  lastError     String?
  nextAttemptAt DateTime?
  sentAt        DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([tenantId])
  @@index([status, nextAttemptAt])
  @@index([createdAt(sort: Desc)])
  @@map("email_logs")
}

// Catálogo de sitios/porterías. El "dónde" semántico del escaneo.
model Site {
  id           String   @id @default(uuid())
  tenantId     String   @default(dbgenerated("current_setting('app.tenant_id'::text, true)"))
  name         String
  code         String?
  active       Boolean  @default(true)
  latitude     Float?
  longitude    Float?
  radiusMeters Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  accessEvents AccessEvent[]

  @@unique([tenantId, name])
  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("sites")
}

// Evento de control de acceso. Cada escaneo es una fila inmutable; la jornada
// (entrada + salida) se deriva por consulta, nunca se materializa. La anulación
// es lógica (`voidedAt`/`voidedById`/`voidReason`): jamás se hace DELETE.
model AccessEvent {
  id              String          @id @default(uuid())
  tenantId        String          @default(dbgenerated("current_setting('app.tenant_id'::text, true)"))
  type            AccessEventType
  // Hora autoritativa del servidor. El `deviceTimestamp` es solo auditoría.
  occurredAt      DateTime        @default(now())
  deviceTimestamp DateTime?

  employeeId             String
  employee               User    @relation("AccessEventEmployee", fields: [employeeId], references: [id], onDelete: Restrict)
  employeeNameSnapshot   String?
  employeeNumberSnapshot String?

  guardId String?
  guard   User?   @relation("AccessEventGuard", fields: [guardId], references: [id], onDelete: SetNull)

  siteId String?
  site   Site?   @relation(fields: [siteId], references: [id], onDelete: SetNull)

  latitude          Float?
  longitude         Float?
  gpsAccuracyMeters Float?
  locationSource    AccessLocationSource
  method            AccessMethod

  credentialVersion  Int?
  scannedPayloadHash String?

  // Idempotencia generada en el dispositivo.
  clientEventId String? @unique
  deviceId      String?
  deviceCode    String?

  notes String?

  // Anulación lógica.
  voidedAt   DateTime?
  voidedById String?
  voidReason String?

  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([occurredAt])
  @@index([employeeId, occurredAt])
  @@index([siteId])
  @@index([guardId])
  @@index([type])
  @@map("access_events")
}

// ---------------------------------------------------------------------------
// Horarios (administración) y asignación de horarios al personal.
// ---------------------------------------------------------------------------

/// Catálogo de horarios. La rejilla por día permite horarios que cambian por
/// día de la semana. Las horas son "de pared" (HH:mm), no instantes.
model Schedule {
  id       String  @id @default(uuid())
  tenantId String  @default(dbgenerated("current_setting('app.tenant_id'::text, true)"))
  name     String
  active   Boolean @default(true)

  // Reglas de horas extra (minutos).
  entryToleranceMin Int     @default(10)
  exitToleranceMin  Int     @default(10)
  mealBreakMin      Int     @default(0)
  // Mínimo de tiempo extra para que cuente (0 = sin mínimo).
  minOvertimeMin    Int     @default(60)
  // Si la salida cae al día siguiente (turno nocturno).
  crossesMidnight   Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  days        ScheduleDay[]
  assignments ScheduleAssignment[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("schedules")
}

/// Rejilla del horario por día de la semana (1=Lunes … 7=Domingo).
model ScheduleDay {
  id         String   @id @default(uuid())
  tenantId   String   @default(dbgenerated("current_setting('app.tenant_id'::text, true)"))
  scheduleId String
  schedule   Schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  weekday    Int // 1..7

  startTime      String?
  endTime        String?
  // Turno partido (p. ej. camaristas/restaurante): segundo tramo opcional.
  splitStartTime String?
  splitEndTime   String?
  restDay        Boolean @default(false)

  @@unique([scheduleId, weekday])
  @@index([tenantId])
  @@map("schedule_days")
}

/// Vigencia de un horario para una persona. El vigente es el que cubre "hoy".
model ScheduleAssignment {
  id         String    @id @default(uuid())
  tenantId   String    @default(dbgenerated("current_setting('app.tenant_id'::text, true)"))
  userId     String
  user       User      @relation("ScheduleAssignee", fields: [userId], references: [id])
  scheduleId String
  schedule   Schedule  @relation(fields: [scheduleId], references: [id])
  validFrom  DateTime
  validTo    DateTime?
  createdAt  DateTime  @default(now())

  createdById String?
  createdBy   User?   @relation("ScheduleAssignmentCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([userId, validFrom, validTo])
  @@index([scheduleId])
  @@map("schedule_assignments")
}

// ---------------------------------------------------------------------------
// Pre-nómina: revisión por departamento y cierre de la semana.
// ---------------------------------------------------------------------------

/// Cierre de la pre-nómina de una semana. Una semana se cierra una vez: al
/// reabrir y volver a cerrar se actualiza la misma fila (la bitácora guarda
/// el historial de cada cambio).
model PayrollWeekClosure {
  id        String   @id @default(uuid())
  tenantId  String   @default(dbgenerated("current_setting('app.tenant_id'::text, true)"))
  /// Primer día de la semana cerrada (clave natural, por cliente).
  weekStart DateTime @db.Date

  closedById String?
  closedBy   User?    @relation("PayrollWeekCloser", fields: [closedById], references: [id], onDelete: SetNull)
  closedAt   DateTime @default(now())

  reopenedById String?
  reopenedBy   User?     @relation("PayrollWeekReopener", fields: [reopenedById], references: [id], onDelete: SetNull)
  reopenedAt   DateTime?

  /// Fotografía de las cifras al cerrar, por si luego se editan checadas.
  snapshot Json?

  @@unique([tenantId, weekStart])
  @@index([tenantId])
  @@map("payroll_week_closures")
}

/// Revisión de un departamento en una semana (`departmentId` null = el grupo
/// sin departamento). La unicidad real es (weekStart, COALESCE(departmentId,'')):
/// índice funcional creado en la migración (un unique de Prisma no trataría
/// el null como un valor).
model PayrollDepartmentReview {
  id           String      @id @default(uuid())
  tenantId     String      @default(dbgenerated("current_setting('app.tenant_id'::text, true)"))
  weekStart    DateTime    @db.Date
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  /// true = marcada con «Marcar todo como revisado»; false = desde su detalle.
  bulk Boolean @default(false)

  reviewedById String?
  reviewedBy   User?    @relation("PayrollDepartmentReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt   DateTime @default(now())

  @@index([tenantId])
  @@index([weekStart])
  @@map("payroll_department_reviews")
}

// ---------------------------------------------------------------------------
// Checador (reloj Hikvision). Copia de SOLO LECTURA de los eventos del equipo:
// la API nunca escribe en el reloj, solo lee su bitácora por ISAPI.
// ---------------------------------------------------------------------------

/// Cómo se identificó el empleado en el reloj (derivado del `minor` ISAPI).
enum PunchMethod {
  FACE
  FINGERPRINT
  CARD
  OTHER
}

/// Checada de un empleado identificado por el reloj. Inmutable: se copia tal
/// cual del equipo y nunca se edita. `serialNo` es el consecutivo del evento en
/// el reloj; con la serie del equipo identifica la checada, lo que hace
/// idempotente la sincronización.
model TimeClockPunch {
  id             String      @id @default(uuid())
  tenantId       String      @default(dbgenerated("current_setting('app.tenant_id'::text, true)"))
  clockSerial    String
  serialNo       Int
  // Número y nombre tal como están dados de alta en el reloj.
  employeeNumber String
  name           String
  method         PunchMethod
  // Código `minor` del evento ISAPI (75 rostro, 38 huella, 1 tarjeta, …).
  minor          Int
  // Instante de la checada según el reloj del equipo.
  occurredAt     DateTime
  createdAt      DateTime    @default(now())

  /// Correcciones ligadas (la checada es inmutable, F2-01): se corrigen por
  /// registro de ajuste, nunca editando/borrando la fila.
  adjustments PunchAdjustment[]

  @@unique([clockSerial, serialNo])
  @@index([tenantId])
  @@index([occurredAt])
  @@index([employeeNumber, occurredAt])
  @@map("time_clock_punches")
}

/// Un reloj checador, identificado por su número de serie: cómo conectarse
/// (`url`, se da de alta desde la web) y hasta dónde se ha leído.
///
/// Cursor: todo evento con consecutivo `<= lastSerialNo` ya se procesó. Solo
/// avanza con una ventana o una corrida completas; si una corrida se corta, la
/// siguiente repite desde aquí y los duplicados se descartan por el `@@unique`
/// de `time_clock_punches`.
///
/// Dar de baja solo borra la `url`: el cursor, el nombre y las checadas se
/// quedan, y si el reloj se vuelve a dar de alta sigue desde donde iba.
model TimeClock {
  serialNumber      String                 @id
  tenantId          String                 @default(dbgenerated("current_setting('app.tenant_id'::text, true)"))
  /// Para reconocerlo en pantalla (p. ej. "Entrada de personal").
  name              String?
  /// `http(s)://host[:puerto]`; `null` = dado de baja (no se sincroniza).
  url               String?
  /// Si sus checadas arman las entradas/salidas (y las horas extra). Los
  /// relojes de puertas de oficina se checan varias veces por turno: sus
  /// checadas se guardan, pero no cuentan como entrada o salida.
  countsAttendance  Boolean                @default(true)
  /// Si la API puede escribir en este reloj (altas, bajas, huellas). Apagado por defecto:
  /// un reloj real solo acepta escritura cuando se habilita a propósito. El mock siempre acepta.
  writeEnabled      Boolean                @default(false)
  /// Usuario admin del propio equipo (F1B-10). Write-only: el API solo lo
  /// devuelve, nunca la contraseña. `null` = usa el fallback del `.env`.
  username          String?
  /// Contraseña del reloj cifrada con AES-256-GCM (`core/utils/crypto`).
  /// Nunca se devuelve ni se registra en claro.
  passwordEncrypted String?
  /// API key del equipo para ingesta directa de checadas (F1B-06). Solo se
  /// guarda el hash SHA-256; la key en claro se muestra una vez al rotarla.
  apiKeyHash        String?
  /// Prefijo visible (`tmc_xxxx…`) para identificar la key en soporte.
  apiKeyPrefix      String?
  apiKeyCreatedAt   DateTime?
  model             String?
  lastSerialNo      Int                    @default(0)
  syncedAt          DateTime?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  syncEvents        TimeClockSyncEvent[]
  rosterEntries     TimeClockRosterEntry[]

  @@unique([tenantId, url])
  @@index([tenantId])
  @@map("time_clocks")
}

/// Un intento de sincronización con un reloj: es el timeline que ve soporte
/// ("falló → reintentó → conectó → volvió a fallar"). Guarda si conectó, qué
/// leyó y, cuando falla, el motivo tal cual lo reportó el equipo.
model TimeClockSyncEvent {
  id           String    @id @default(uuid())
  tenantId     String    @default(dbgenerated("current_setting('app.tenant_id'::text, true)"))
  clockSerial  String
  /// Quién lo disparó: `AUTO` (cada 5 minutos), `MANUAL` (Sincronizar todo),
  /// `IMPORT` (importar por rango de fechas) o `REGISTER` (alta del reloj).
  trigger      String
  ok           Boolean
  startedAt    DateTime
  finishedAt   DateTime
  /// Eventos del reloj revisados (por consecutivo); de ellos, las checadas.
  readCount    Int       @default(0)
  /// Checadas nuevas guardadas en este intento.
  newCount     Int       @default(0)
  /// Cursor al terminar; `null` si falló antes de saberlo.
  lastSerialNo Int?
  /// Motivo del fallo, tal cual (p. ej. "connect ECONNREFUSED 192.168.1.135:443").
  error        String?
  clock        TimeClock @relation(fields: [clockSerial], references: [serialNumber], onDelete: Cascade)

  @@index([tenantId])
  @@index([clockSerial, startedAt])
  @@map("time_clock_sync_events")
}

/// Vínculo entre un empleado del reloj (su número en el equipo) y un usuario
/// del sistema. Es explícito: el número del reloj NO se compara tal cual con
/// `User.employeeNumber`, porque el reloj antepone el área (070562 ↔ 562) y el
/// número de nómina se repite entre áreas (040001 y 110001). Un usuario puede
/// tener más de un número de reloj (p. ej. si lo dieron de alta dos veces).
model TimeClockEmployee {
  tenantId       String
  employeeNumber String
  userId         String
  user           User                    @relation("TimeClockEmployeeUser", fields: [userId], references: [id], onDelete: Cascade)
  linkedById     String?
  linkedBy       User?                   @relation("TimeClockEmployeeLinker", fields: [linkedById], references: [id], onDelete: SetNull)
  /// Padrón: `BAJA_PENDIENTE` cuando dejó de aparecer en los relojes que cuentan
  /// y espera un motivo. Mientras tanto el usuario sigue activo.
  status         TimeClockEmployeeStatus @default(ACTIVE)
  /// Corridas seguidas del padrón sin aparecer en ningún reloj que cuenta.
  missingRuns    Int                     @default(0)
  missingSince   DateTime?
  /// Cuándo reapareció en el reloj un usuario ya dado de baja (para RH).
  reappearedAt   DateTime?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  @@id([tenantId, employeeNumber])
  @@index([userId])
  @@map("time_clock_employees")
}

enum TimeClockEmployeeStatus {
  ACTIVE
  PENDING_REMOVAL
}

/// Motivos de baja (catálogo administrable, como las categorías de ticket).
/// `key` es el código estable que usa el sistema; `name` se puede editar.
model RemovalCategory {
  id        String   @id @default(uuid())
  tenantId  String   @default(dbgenerated("current_setting('app.tenant_id'::text, true)"))
  key       String
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  users     User[]   @relation("UserDeactivationCategory")

  @@unique([tenantId, key])
  @@index([tenantId])
  @@map("removal_categories")
}

/// Lo que vio cada reloj que cuenta en su última lectura válida del padrón.
model TimeClockRosterEntry {
  id             String    @id @default(uuid())
  tenantId       String    @default(dbgenerated("current_setting('app.tenant_id'::text, true)"))
  clockSerial    String
  clock          TimeClock @relation(fields: [clockSerial], references: [serialNumber], onDelete: Cascade)
  employeeNumber String
  name           String
  lastSeenAt     DateTime

  @@unique([clockSerial, employeeNumber])
  @@index([tenantId])
  @@index([employeeNumber])
  @@map("time_clock_roster_entries")
}

/// Una corrida del padrón: para soporte y para la guarda de caída masiva.
model TimeClockRosterRun {
  id             String   @id @default(uuid())
  tenantId       String   @default(dbgenerated("current_setting('app.tenant_id'::text, true)"))
  trigger        String
  startedAt      DateTime
  finishedAt     DateTime
  ok             Boolean
  suspicious     Boolean  @default(false)
  added          Int      @default(0)
  removalPending Int      @default(0)
  cancelled      Int      @default(0)
  reappeared     Int      @default(0)
  /// `[{ serial, ok, count, error }]` por reloj.
  perClock       Json

  @@index([tenantId])
  @@index([startedAt])
  @@map("time_clock_roster_runs")
}

// ---------------------------------------------------------------------------
// Tiempo extra: decisión de aprobación por persona y día. La ausencia de fila
// significa PENDIENTE; solo se guardan las decisiones (aprobado/rechazado) con
// el snapshot del cálculo vigente al momento de decidir.
// ---------------------------------------------------------------------------

enum OvertimeApprovalStatus {
  APPROVED
  REJECTED
}

model OvertimeApproval {
  id           String                 @id @default(uuid())
  tenantId     String                 @default(dbgenerated("current_setting('app.tenant_id'::text, true)"))
  userId       String
  user         User                   @relation("OvertimeApprovalUser", fields: [userId], references: [id], onDelete: Cascade)
  date         DateTime               @db.Date
  status       OvertimeApprovalStatus
  // Snapshot del cálculo al momento de decidir (inmutable).
  extraMin     Int
  scheduleName String?
  scheduledMin Int?
  note         String?
  decidedById  String?
  decidedBy    User?                  @relation("OvertimeApprovalDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt    DateTime?
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  @@unique([userId, date])
  @@index([tenantId])
  @@index([date])
  @@index([status])
  @@map("overtime_approvals")
}

/// Catálogo de días festivos por cliente (art. 74 LFT): obligatorios y de
/// convenio. Se siembran los obligatorios por año desde el servicio.
enum HolidayKind {
  OBLIGATORIO
  CONVENIO
}

model Holiday {
  id       String @id @default(uuid())
  tenantId String @default(dbgenerated("current_setting('app.tenant_id'::text, true)"))
  date     DateTime @db.Date
  name     String
  kind     HolidayKind @default(OBLIGATORIO)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, date])
  @@index([tenantId, date])
  @@map("holidays")
}

/// Estado del snapshot semanal de horas extra (F1).
enum WeeklyOvertimeStatus {
  DRAFT
  CONFIRMED
  CLOSED
}

/// Snapshot inmutable por persona/semana de la clasificación de horas extra
/// (doble, triple y excedente ilegal), con el detalle día por día y la versión
/// del motor. Se recalcula mientras está DRAFT y se congela al confirmar/cerrar.
model WeeklyOvertimeLedger {
  id      String @id @default(uuid())
  tenantId String @default(dbgenerated("current_setting('app.tenant_id'::text, true)"))
  userId  String
  user    User   @relation("WeeklyOvertimeLedgerUser", fields: [userId], references: [id], onDelete: Cascade)
  /// Lunes local de la semana (UTC-medianoche).
  weekStart DateTime @db.Date
  year      Int

  ordinaryMin       Int @default(0)
  otDoubleMin       Int @default(0)
  otTripleMin       Int @default(0)
  otIllegalMin      Int @default(0)
  restDayWorkedMin  Int @default(0)
  holidayWorkedMin  Int @default(0)
  sundayWorked      Boolean @default(false)
  minor             Boolean @default(false)
  violations        Json    @default("[]")
  days              Json    @default("[]")
  engineVersion     String

  status        WeeklyOvertimeStatus @default(DRAFT)
  workerAckAt   DateTime?
  workerAckHash String?
  confirmedById String?
  confirmedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, userId, weekStart])
  @@index([tenantId, weekStart])
  @@index([userId, weekStart])
  @@index([status])
  @@map("weekly_overtime_ledgers")
}

/// Estado de la conformidad periódica del trabajador con su resumen de jornada.
/// Tipos de ausencia/permiso configurables por cliente.
enum LeaveKind {
  VACATION
  PAID_LEAVE
  UNPAID_LEAVE
  SICK_LEAVE
  OTHER
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model LeaveType {
  id       String @id @default(uuid())
  tenantId String @default(dbgenerated("current_setting('app.tenant_id'::text, true)"))
  key      String
  name     String
  kind     LeaveKind @default(OTHER)
  paid     Boolean  @default(false)
  active   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  requests LeaveRequest[]

  @@unique([tenantId, key])
  @@index([tenantId, active])
  @@map("leave_types")
}

/// Solicitud de vacaciones/permiso con aprobación. `days` se calcula del rango.
model LeaveRequest {
  id        String @id @default(uuid())
  tenantId  String @default(dbgenerated("current_setting('app.tenant_id'::text, true)"))
  userId    String
  user      User   @relation("LeaveRequestUser", fields: [userId], references: [id], onDelete: Cascade)
  typeId    String
  type      LeaveType @relation(fields: [typeId], references: [id], onDelete: Restrict)
  startDate DateTime @db.Date
  endDate   DateTime @db.Date
  days      Int
  status    LeaveStatus @default(PENDING)
  reason    String?
  decidedById String?
  decidedAt DateTime?
  decisionNote String?
  createdById String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, status])
  @@index([userId, startDate])
  @@map("leave_requests")
}

enum WorkRecordAckStatus {
  PENDING
  ACCEPTED
  DISCREPANCY
}

/// Estado de una solicitud previa de horas extra (autorización del patrón +
/// consentimiento del trabajador, arts. 66 y 68 LFT).
enum OvertimeRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
}

/// Solicitud previa de horas extra: el patrón la pide con motivo, días y
/// minutos estimados y el trabajador la acepta o rechaza desde Mi jornada.
/// Aceptar/rechazar no altera el registro: lo trabajado se calcula igual.
model OvertimeRequest {
  id            String @id @default(uuid())
  tenantId      String @default(dbgenerated("current_setting('app.tenant_id'::text, true)"))
  userId        String
  user          User   @relation("OvertimeRequestUser", fields: [userId], references: [id], onDelete: Cascade)
  requestedById String
  requestedBy   User   @relation("OvertimeRequestRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  reason        String
  plannedMin    Int
  /// Días propuestos (JSON array de `YYYY-MM-DD`).
  days          Json   @default("[]")
  status        OvertimeRequestStatus @default(PENDING)
  workerNote    String?
  workerDecidedAt DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([tenantId, status])
  @@index([userId, createdAt])
  @@map("overtime_requests")
}

/// Acuerdo del método de registro (art. 132 fr. XXXIV, prueba plena): método(s),
/// reglas de redondeo y corrección, versión del texto y aceptación firmada por
/// hash con fecha e IP. Uno por persona y cliente.
model WorkRecordAgreement {
  id       String @id @default(uuid())
  tenantId String @default(dbgenerated("current_setting('app.tenant_id'::text, true)"))
  userId   String @unique
  user     User   @relation("WorkRecordAgreementUser", fields: [userId], references: [id], onDelete: Cascade)
  /// Métodos acordados: ["CLOCK"], ["REMOTE"], ["CLOCK","REMOTE"], ["ACCESS"].
  methods        Json
  roundingPolicy String?
  correctionRules String?
  textVersion    Int      @default(1)
  acceptedAt     DateTime?
  acceptedIp     String?
  acceptedHash   String?
  /// Firma patronal (RJ-07): sin ella el acuerdo es unilateral.
  employerAcceptedAt   DateTime?
  employerAcceptedIp   String?
  employerAcceptedHash String?
  employerAcceptedById String?
  employerAcceptedBy   User?   @relation("WorkRecordAgreementEmployer", fields: [employerAcceptedById], references: [id], onDelete: SetNull)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  versions WorkRecordAgreementVersion[]

  @@index([tenantId])
  @@map("work_record_agreements")
}

/// Conformidad periódica: el trabajador ve su resumen (ordinaria, extra doble/
/// triple/ilegal, descansos) y lo acepta o abre una discrepancia. El hash del
/// resumen aceptado queda como evidencia.
/// Historial append-only de versiones del acuerdo de método de registro.
model WorkRecordAgreementVersion {
  id           String @id @default(uuid())
  tenantId     String @default(dbgenerated("current_setting('app.tenant_id'::text, true)"))
  agreementId  String
  agreement    WorkRecordAgreement @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  userId       String
  methods      Json
  roundingPolicy   String?
  correctionRules  String?
  textVersion  Int
  acceptedAt   DateTime?
  acceptedIp   String?
  acceptedHash String?
  employerAcceptedAt   DateTime?
  employerAcceptedIp   String?
  employerAcceptedHash String?
  employerAcceptedById String?
  createdAt    DateTime @default(now())

  @@index([tenantId, agreementId])
  @@index([userId])
  @@map("work_record_agreement_versions")
}

model WorkRecordAcknowledgment {
  id          String @id @default(uuid())
  tenantId    String @default(dbgenerated("current_setting('app.tenant_id'::text, true)"))
  userId      String
  user        User   @relation("WorkRecordAcknowledgmentUser", fields: [userId], references: [id], onDelete: Cascade)
  periodStart DateTime @db.Date
  periodEnd   DateTime @db.Date
  summary     Json
  summaryHash String
  status      WorkRecordAckStatus @default(PENDING)
  acceptedAt  DateTime?
  workerIp    String?
  discrepancyNote String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([tenantId, userId, periodStart, periodEnd])
  @@index([tenantId, periodStart])
  @@index([userId, periodStart])
  @@map("work_record_acknowledgments")
}

// ---------------------------------------------------------------------------
// Permisos: tanto el catálogo como la matriz rol → permiso → alcance viven en
// la base. El catálogo (`permissions`) es la fuente única de verdad de las
// claves; `role_permissions` las referencia por FK.
// ---------------------------------------------------------------------------

enum PermissionScope {
  NONE
  OWN
  AREA
  ALL
}

/// Roles del sistema (dinámicos). Antes era el enum `Role`; ahora es una tabla
/// administrable desde `/roles` (permiso `roles.manage`). `system` protege los
/// roles base (no se renombran ni borran); `staff` marca los roles con
/// expediente de personal (RH: checador, nómina, horas extra); `module` es el
/// dominio con el que se agrupan en la pantalla (p. ej. "RH", "Nómina").
model Role {
  key         String   @id
  name        String
  description String?
  module      String?
  staff       Boolean  @default(false)
  system      Boolean  @default(false)
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       User[]
  permissions RolePermission[]
  userRoles   UserRole[]
  policyRoles PolicyRole[]

  @@index([module, sortOrder])
  @@map("roles")
}

/// Roles adicionales de un usuario (multi-rol). `User.role` sigue siendo el rol
/// principal; esta tabla agrega los demás. Los permisos efectivos son la unión
/// de todos los roles del usuario (gana el alcance mayor).
model UserRole {
  userId    String
  role      String
  createdAt DateTime @default(now())

  user    User @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleRef Role @relation(fields: [role], references: [key], onDelete: Cascade, onUpdate: Cascade)

  @@id([userId, role])
  @@map("user_roles")
}

/// Catálogo de permisos (clave `module.action`). Fuente única de verdad en BD.
model Permission {
  key             String            @id
  module          String
  name            String
  description     String?
  scopes          PermissionScope[]
  sensitive       Boolean           @default(false)
  active          Boolean           @default(true)
  sortOrder       Int               @default(0)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  roles           RolePermission[]
  userPermissions UserPermission[]

  @@index([module, sortOrder])
  @@map("permissions")
}

/// Matriz rol → permiso → alcance. La ausencia de fila equivale a NONE; una
/// fila con NONE quita el permiso del rol de forma explícita (y evita que el
/// backfill del arranque lo reintroduzca). `permission` referencia el catálogo
/// en base (`permissions.key`) por FK con borrado/actualización en cascada.
model RolePermission {
  id         String          @id @default(uuid())
  role       String
  permission String
  scope      PermissionScope
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  roleRef       Role       @relation(fields: [role], references: [key], onDelete: Cascade, onUpdate: Cascade)
  permissionRef Permission @relation(fields: [permission], references: [key], onDelete: Cascade, onUpdate: Cascade)

  @@unique([role, permission])
  @@map("role_permissions")
}

/// Excepción de permiso de un empleado (Fase 2). Reemplaza lo que dice su rol:
/// `scope = NONE` lo quita. Opcional: motivo y fecha de vencimiento.
model UserPermission {
  id          String          @id @default(uuid())
  userId      String
  permission  String
  scope       PermissionScope
  reason      String?
  expiresAt   DateTime?
  grantedById String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  user          User       @relation("UserPermissionGrants", fields: [userId], references: [id], onDelete: Cascade)
  grantedBy     User?      @relation("UserPermissionGrantedBy", fields: [grantedById], references: [id], onDelete: SetNull)
  permissionRef Permission @relation(fields: [permission], references: [key], onDelete: Cascade, onUpdate: Cascade)

  @@unique([userId, permission])
  @@map("user_permissions")
}

// ---------------------------------------------------------------------------
// Políticas ABAC dinámicas: reglas de contexto (estado, montos, segregación de
// funciones) evaluadas sobre una acción ya permitida por el RBAC. Se administran
// desde la web (`/roles` → Políticas). La primera regla que casa por prioridad
// decide; sin reglas que casen, se permite (el permiso ya lo autorizó).
// ---------------------------------------------------------------------------

enum PolicyEffect {
  ALLOW
  DENY
}

model Policy {
  id          String       @id @default(uuid())
  /// Clave estable de las políticas base sembradas (null en las creadas a mano).
  key         String?      @unique
  name        String
  description String?
  /// Acción (clave de permiso) sobre la que aplica, p. ej. `purchase_orders.approve`.
  action      String
  effect      PolicyEffect
  priority    Int          @default(100)
  active      Boolean      @default(true)
  createdById String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  createdBy  User?             @relation("PolicyCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  conditions PolicyCondition[]
  roles      PolicyRole[]

  @@index([action, active, priority])
  @@map("policies")
}

/// Condición de una política: `field operator value` (p. ej. total gt 10000).
model PolicyCondition {
  id       String  @id @default(uuid())
  policyId String
  field    String
  operator String
  value    String?

  policy Policy @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@index([policyId])
  @@map("policy_conditions")
}

/// Roles a los que aplica la política. Sin filas = aplica a todos.
model PolicyRole {
  policyId String
  role     String

  policy  Policy @relation(fields: [policyId], references: [id], onDelete: Cascade)
  roleRef Role   @relation(fields: [role], references: [key], onDelete: Cascade, onUpdate: Cascade)

  @@id([policyId, role])
  @@map("policy_roles")
}

// ─────────────────────────────────────────────────────────────────────────────
// Almacén de cocina (KITCHEN_STORE.md). Existencias por lote con caducidad y
// cantidades decimales; una sola regla de kardex (kitchenLedgerDelta).
// ─────────────────────────────────────────────────────────────────────────────

/// CONSUMABLE baja por consumo (ingredientes, desechables); DURABLE solo por
/// merma (utensilios, vajilla).
enum KitchenItemKind {
  CONSUMABLE
  DURABLE
}

enum KitchenStorage {
  DRY
