enum OutOfHoursContactChannel {
  CALL
  MESSAGE
  EMAIL
  OTHER
}

/// Control de comunicaciones fuera de jornada (NOM-037 / desconexión): el
/// cliente marca un contacto fuera del horario y se avisa a la persona.
model OutOfHoursContact {
  id               String                   @id @default(uuid())
  tenantId         String                   @default(dbgenerated("current_setting('app.tenant_id'::text, true)"))
  userId           String
  user             User                     @relation("OutOfHoursContactUser", fields: [userId], references: [id], onDelete: Cascade)
  contactedAt      DateTime
