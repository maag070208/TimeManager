{
  "name": "timemanager-api",
  "version": "1.0.0",
  "main": "dist/index.js",
  "license": "MIT",
  "scripts": {
    "dev": "npx nodemon",
    "build": "rimraf ./dist && tsc && tsc-alias",
    "start": "node dist/src/index.js",
    "lint": "eslint .",
    "prisma:generate": "npx prisma generate",
    "prisma:migrate": "npx prisma migrate deploy",
    "prisma:migrate:dev": "npx prisma migrate dev",
    "mock:access": "ts-node prisma/mock-access.ts",
    "mock:attendance": "ts-node -r tsconfig-paths/register prisma/mock-attendance.ts",
    "seed": "ts-node -r tsconfig-paths/register prisma/seed.ts",
    "demo:seed": "ts-node -r tsconfig-paths/register scripts/demo-seed.ts",
    "test:unit": "node --require ts-node/register/transpile-only --require tsconfig-paths/register --test \"src/**/*.test.ts\"",
    "db:test:up": "bash scripts/integration-db.sh",
    "test:integration": "bash scripts/test-integration.sh",
    "tenancy-check": "ts-node -r tsconfig-paths/register scripts/tenancy-check.ts",
    "workers": "ts-node -r tsconfig-paths/register src/workers/index.ts",
    "workers:prod": "node dist/src/workers/index.js",
    "qa:bots": "ts-node -r tsconfig-paths/register qa/run.ts",
    "qa:bots:local": "node qa/run-local.mjs"
  },
  "prisma": {
    "seed": "ts-node -r tsconfig-paths/register prisma/seed.ts"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "7.3.4",
    "@aws-sdk/client-s3": "^3.787.0",
    "@aws-sdk/s3-request-presigner": "^3.787.0",
    "@prisma/client": "^5.10.2",
    "@types/nodemailer": "^8.0.2",
    "ably": "^2.27.0",
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "express-rate-limit": "^8.7.3",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^2.3.0",
    "nodemailer": "^10.0.10",
    "pg-boss": "9.0.3",
    "prom-client": "^15.1.3",
    "resend": "^4.5.1",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.19.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.12",
    "@types/node": "^20.11.0",
    "@types/swagger-ui-express": "^4.1.8",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "eslint": "^10.10.0",
    "nodemon": "^3.0.2",
    "prisma": "^5.10.2",
    "rimraf": "^5.0.5",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.10",
    "tsconfig-paths": "^4.2.0",
    "xlsx": "^0.18.5",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.70.0"
  }
}
