# API
NODE_ENV=production
PORT=4001
DATABASE_URL=postgresql://cartas:cartas_dev_pwd@postgres:5432/cartas?schema=public
# Cifra en reposo los secretos guardados en BD (contraseña de cada reloj,
# F1B-10). Base64 de exactamente 32 bytes; genérala con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Si se deja vacía, la API deriva la clave de JWT_SECRET con HKDF-SHA256 y
# escribe un warning al primer uso: sirve para desarrollo, pero en producción
# fíjala (rotar JWT_SECRET entonces deja ilegibles los secretos guardados).
ENCRYPTION_KEY=
# Zona horaria oficial para los boundaries locales (reporte de entradas/salidas y
# bitácora). El contenedor corre en UTC: no confíes en su TZ. Precedencia:
# filters.tz → sys_config.ACCESS_REPORT_TIMEZONE → TZ → America/Mexico_City.
TZ=America/Mexico_City
ACCESS_REPORT_TIMEZONE=America/Mexico_City
# Orígenes de la web (coma). Comodín de subdominio por cliente: http://*.localhost:5006
WEB_ORIGIN=http://localhost:5006,http://*.localhost:5006
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET_NAME=
AWS_REGION=us-east-2
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Legacy fallback. La tabla `sys_config` (clave EMAIL_NOTIFICATION_RECIPIENTS,
# editable desde /catalogos → Notificaciones, ADMIN) toma precedencia. El env
# sólo se usa cuando la fila de BD no existe (al primer arranque, sirve como
# seed inicial).
NOTIFICATION_EMAILS=aamaro@axzy.dev,maag070208@gmail.com
UPLOAD_MAX_BYTES=10485760
# Máximo por adjunto en los correos de "documento cargado" (Resend: 40MB
# post-base64). Archivos más grandes viajan solo con el enlace en el cuerpo.
EMAIL_ATTACH_MAX_BYTES=20971520

# Cola desatendida de correo (email_logs + worker en background).
# EMAIL_QUEUE_POLL_MS=2000
# EMAIL_QUEUE_BATCH_SIZE=10
# EMAIL_QUEUE_CONCURRENCY=5
# EMAIL_QUEUE_MAX_ATTEMPTS=5
# EMAIL_QUEUE_RETRY_BASE_MS=1000

# SMTP (nodemailer) — hostinger. Si se dejan vacíos, el envío entra en dry-run.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=true
SMTP_FROM=
SMTP_CONNECTION_TIMEOUT=10000
EMAIL_DRY_RUN=false

# Relojes checadores Hikvision (ISAPI). La API SOLO LEE de los equipos: nunca
# les escribe configuración ni activa push. Los relojes se dan de alta desde la
# web (Control de acceso → Relojes) y cada reloj guarda su propio usuario y
# contraseña cifrados en BD (se capturan al darlo de alta y se editan con
# PATCH /time-clock/clocks/:serial; son write-only: el API nunca los devuelve).
# Este par es SOLO el fallback de desarrollo/E2E para relojes sin credenciales
# propias. Sin ninguno de los dos la sincronización no arranca.
TIME_CLOCK_USER=
TIME_CLOCK_PASS=
# Cada cuánto se traen los eventos nuevos (ms). Default 5 min.
TIME_CLOCK_SYNC_INTERVAL_MS=300000

# ── Infraestructura y escala (F1B-01/02/07, F1C-03, F4-03) ──────────────────
# RLS de Postgres como red de seguridad (ver prisma/rls/roles.sql): exige que
# DATABASE_URL use un rol SIN BYPASSRLS (tm_app). El proceso de workers puede
# usar WORKER_DATABASE_URL (tm_worker, con BYPASSRLS) para iterar clientes.
RLS_ENABLED=false
# PgBouncer (Railway) en modo transacción: regla réplicas × connection_limit
# ≤ 70% del máximo de conexiones de la BD. Con PgBouncer, DATABASE_PGBOUNCER=true
# (Prisma desactiva prepared statements). Ver docs/OPERACION_PRODUCCION.md.
# DATABASE_CONNECTION_LIMIT=10
# DATABASE_POOL_TIMEOUT=10000
# DATABASE_PGBOUNCER=false
# WORKER_DATABASE_URL=postgresql://tm_worker:...@host:5432/db
# ¿Correr los workers periódicos dentro del API? Solo desarrollo/local.
RUN_WORKERS_IN_API=false
# Cola pg-boss (schema `pgboss` en la misma BD). La usa el proceso de workers.
QUEUE_ENABLED=true
LEADER_LOCK_TTL_MS=30000
LEADER_LOCK_RETRY_MS=10000
# Producción (F1C-03): saltos de proxy para ip/rate limit, tope del body JSON,
# rate limiting en memoria y observabilidad.
TRUST_PROXY=
BODY_LIMIT=1mb
RATE_LIMIT_DISABLED=false
RATE_LIMIT_LOGIN_MAX=20
RATE_LIMIT_QUERY_MAX=600
RATE_LIMIT_WINDOW_MS=900000
# GET /metrics: token fijo o (sin él) JWT de ADMIN/SUPPORT.
METRICS_TOKEN=
# Logs JSON con request-id/tenant/user. Default: true en producción.
LOG_JSON=

# ── Faltaban en el ejemplo (F1C-06) ──────────────────────────────────────
# Firma de JWT (obligatoria: la API no arranca sin ella).
JWT_SECRET=
# Ably: app key del servidor (notificaciones en vivo y tokens de ably).
# Sin ella la app funciona, pero no hay notificaciones en tiempo real.
ABLY_API_KEY=
# Seed inicial (pnpm seed): solo se usa si el usuario no existe.
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=

# Estación de huellas DS-K1F600U: la configuración normal vive en BD
# (GET/PUT /time-clock/fingerprint-station/config, solo plataforma). Estas
# variables son solo el fallback de desarrollo/E2E.
FINGERPRINT_STATION_URL=
FINGERPRINT_STATION_USER=
FINGERPRINT_STATION_PASS=
