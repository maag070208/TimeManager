TEAM_ID=

PRODUCT_NAME=checklab
PRODUCT_BUNDLE_IDENTIFIER=com.axzydev.checklab.checklab$(TEAM_ID)

CURRENT_PROJECT_VERSION=1
MARKETING_VERSION=1.0

// API de CheckLab. Simulador: localhost de la Mac. iPhone físico: la IP de la Mac en la red
// (p. ej. http:/$()/192.168.1.20:4021/api/v1). `/$()/` evita que xcconfig lea `//` como comentario.
CHECKLAB_API_URL=http:/$()/localhost:4021/api/v1
