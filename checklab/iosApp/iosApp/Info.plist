<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CHECKLAB_API_URL</key>
	<string>$(CHECKLAB_API_URL)</string>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
	</dict>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>CheckLab guarda tu ubicación solo en el momento de checar, nunca en segundo plano.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>CheckLab se conecta al servidor de tu empresa en la red local.</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
</dict>
</plist>
