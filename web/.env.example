# Copiar a `.env.local` (ignorado por git) y completar para desarrollo local.
VITE_API_URL=http://localhost:4001/api/v1

# Google Maps JS API para mostrar la ubicación de las checadas web.
# Sin key, el mapa cae al embed público de OpenStreetMap.
VITE_GOOGLE_MAPS_API_KEY=

# Dominio base de los subdominios de cliente en producción (p. ej. timemanager.mx).
# En el contenedor se define en runtime con TENANT_BASE_DOMAIN (tiene prioridad).
VITE_TENANT_BASE_DOMAIN=

# Runtime (contenedor nginx): la URL del API se inyecta con el env API_URL y
# render-config.sh la escribe en /config.js; tiene prioridad sobre VITE_API_URL.
# API_URL=https://api.timemanager.mx/api/v1
