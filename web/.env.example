# Copiar a `.env.local` (ignorado por git) y completar para desarrollo local.
VITE_API_URL=http://localhost:4001/api/v1

# Key de Ably (app key). Sin ella la app arranca y funciona, pero sin
# notificaciones en vivo (la campanita solo se actualiza al recargar).
VITE_ABLY_API_KEY=

# Dominio base de los subdominios de cliente en producción (p. ej. timemanager.mx).
VITE_TENANT_BASE_DOMAIN=
