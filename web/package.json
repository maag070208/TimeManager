{
  "name": "timemanager-web",
  "private": true,
  "license": "MIT",
  "version": "1.0.0",
  "productName": "CheckLab",
  "description": "CheckLab — control de asistencia, checadas y RH multi-cliente",
  "author": "axzy.dev",
  "main": "dist-electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5009 --strictPort --host 0.0.0.0",
    "server": "vite preview --port 5009 --strictPort --host 127.0.0.1",
    "start": "vite preview --port 5009 --strictPort --host 127.0.0.1",
    "build": "tsc -b && vite build --mode production",
    "build:prod": "tsc -b && vite build --mode production",
    "build:image": "vite build --mode development",
    "lint": "eslint .",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "test:e2e:mobile": "playwright test --project=mobile",
    "test:e2e:report": "playwright show-report",
    "test:e2e:serial": "node scripts/e2e-run.mjs",
    "test:unit": "node --import ./src/test/register.mjs --test $(find src -name \"*.test.ts\")"
  },
  "dependencies": {
    "@axzydev/axzy_ui_system": "1.8.14",
    "@blobatar/react": "2.7.0",
    "@react-pdf/renderer": "^4.6.1",
    "@reduxjs/toolkit": "^2.5.1",
    "ably": "^2.27.0",
    "axios": "^1.7.9",
    "blobatar": "2.7.0",
    "file-saver": "^2.0.5",
    "i18next": "^26.4.2",
    "lottie-react": "^3.1.2",
    "qrcode": "^1.5.4",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-i18next": "^17.0.13",
    "react-icons": "^5.5.0",
    "react-redux": "^9.2.0",
    "react-router-dom": "^7.2.0",
    "yup": "^1.6.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.19.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/file-saver": "^2.0.7",
    "@types/node": "^22.13.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.0.8",
    "@types/react-dom": "19.0.3",
    "@vitejs/plugin-react-swc": "3.8.0",
    "eslint": "^9.19.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.2.0",
    "eslint-plugin-react-hooks": "5.0.0",
    "eslint-plugin-react-refresh": "0.4.18",
    "globals": "^15.14.0",
    "tailwindcss": "4.3.3",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.22.0",
    "vite": "^6.1.0"
  }
}
